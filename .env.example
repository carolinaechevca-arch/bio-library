# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=biolibrary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_PORT=5432

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://mongodb:27017/biolibrary

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=your_password_here
RABBITMQ_EXCHANGE=bio.library.exchange
RABBITMQ_QUEUE=loan.notification.queue
RABBITMQ_ROUTING_KEY=loan.event

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=3600000

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ─── URLs internas (red Docker) ───────────────────────────────────────────────
UNIVERSITY_MOCK_URL=http://university-mock:8081
USER_URL=http://user:8080
CATALOG_URL=http://catalog:8082
NOTIFICATION_URL=http://notification:8084
LOANS_URL=http://loans:8083
